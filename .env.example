# af-console — biến môi trường. Copy thành .env.local rồi điền.
#     cp .env.example .env.local
#
# ⚠️ CHỈ dùng publishable key. TUYỆT ĐỐI KHÔNG đặt secret key / service_role vào đây:
# mọi biến VITE_* đều bị nhúng thẳng vào bundle trình duyệt và ai xem trang cũng đọc được.
# Quyền ghi của console đến từ Supabase Auth + RLS (migration 0002), không phải từ khoá mạnh.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
